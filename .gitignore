# Visual Studio 2015 user specific files
.vs/

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

# Compiled Dynamic libraries
*.so
*.dylib
*.dll

# Fortran module files
*.mod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app
*.ipa

# These project files can be generated by the engine
*.xcodeproj
*.xcworkspace
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb

# misc
sync.ffs_db

# Precompiled Assets
SourceArt/**/*.png
SourceArt/**/*.tga

# Binary Files
Binaries/*
Plugins/*/Binaries/*

# Builds
Build/*

# Whitelist PakBlacklist-<BuildConfiguration>.txt files
!Build/*/
Build/*/**
!Build/*/PakBlacklist*.txt

# Don't ignore icon files in Build
!Build/**/*.ico

# Built data for maps
*_BuiltData.uasset

# Configuration files generated by the Editor
Saved/*

# Compiled source files for the engine to use
Intermediate/*
Plugins/*/Intermediate/*

# Cache files for the editor to use
DerivedDataCache/*

# CkAngelscriptGenerator self-heal stub recovery files (gap fixed 2026-06-10 —
# BB + CkFoundation already had these; without them recovery stubs could be committed)
Script/Generated/_StubRecovery_*.as
Script/Generated/_StubRecovery_*.json

# Generated EntitySpawnParams — regenerated every editor boot; fresh-clone bootstrap
# is covered by self-heal source-derived stub synthesis (see CkFoundation
# CkAngelscriptGenerator/CLAUDE.md). *_AutoTestActors.as and *Assets.as stay
# committed — CkTestsAssets.as hard-references the wrapper actor types.
Script/Generated/CkTests_EntitySpawnParams.as
